<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!--
  Suite Android. O parametro 'platform' diz ao BaseTest que driver criar.
  Executar:  mvn test -Dsuite=testng-android.xml
-->
<suite name="Suite Android" verbose="1">

    <!-- Captura screenshot em falhas e faz log do ciclo de vida -->
    <listeners>
        <listener class-name="com.blog.appium.listeners.TestListener"/>
    </listeners>

    <parameter name="platform" value="android"/>

    <test name="Testes funcionais - Android">
        <classes>
            <class name="com.blog.appium.tests.LoginTest"/>
            <class name="com.blog.appium.tests.HomeTest"/>
        </classes>
    </test>
</suite>
