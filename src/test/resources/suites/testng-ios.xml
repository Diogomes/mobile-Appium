<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!--
  Suite iOS (requer macOS + Xcode).
  Executar:  mvn test -Dsuite=testng-ios.xml
-->
<suite name="Suite iOS" verbose="1">

    <listeners>
        <listener class-name="com.blog.appium.listeners.TestListener"/>
    </listeners>

    <parameter name="platform" value="ios"/>

    <test name="Testes funcionais - iOS">
        <classes>
            <class name="com.blog.appium.tests.LoginTest"/>
            <class name="com.blog.appium.tests.HomeTest"/>
        </classes>
    </test>
</suite>
