<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!--
  Suite de cenarios complexos (data-driven + fluxo de compra ponta-a-ponta).
  Executar:  mvn test -Dsuite=testng-e2e.xml -Dplatform=android
-->
<suite name="Suite E2E" verbose="1">

    <listeners>
        <listener class-name="com.blog.appium.listeners.TestListener"/>
    </listeners>

    <parameter name="platform" value="android"/>

    <test name="Cenarios complexos">
        <classes>
            <class name="com.blog.appium.tests.DataDrivenLoginTest"/>
            <class name="com.blog.appium.tests.PurchaseFlowTest"/>
        </classes>
    </test>
</suite>
